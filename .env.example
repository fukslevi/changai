# Copy to .env for local work; set the same names in the host for production.
# Every value here is a secret except the sender identity.

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Pooled - used by the app at runtime.
DATABASE_URL=
# Direct - used by drizzle-kit for migrations. DDL through a transaction-mode
# pooler is unreliable, so migrations always take the direct host.
DIRECT_DATABASE_URL=

# ── Claude ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Web search (supplier discovery) ───────────────────────────────────────────
SERPER_API_KEY=

# ── Gmail ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Sender identity on outbound mail ─────────────────────────────────────────
# A real named person, from their own mailbox. Suppliers reply to people.
SOURCING_MAILBOX=
SOURCING_SENDER_NAME=
SOURCING_SENDER_TITLE=

# ── App login ─────────────────────────────────────────────────────────────────
# Single shared operator account. AUTH_EMAIL should be the sourcing mailbox.
AUTH_EMAIL=
AUTH_PASSWORD=
# Signs the session cookie. Any long random string; changing it logs everyone out.
AUTH_SECRET=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Bearer token the cron scheduler sends to /api/cron. Without it the route is
# closed: an open endpoint there can send mail to suppliers.
CRON_SECRET=
